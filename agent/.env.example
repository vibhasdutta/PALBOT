BOT_WS_URL=wss://your-bot-host/agent/connect

# Leave AGENT_SITE_HOST unset (defaults to 127.0.0.1) to keep the local
# site reachable only from this machine. Set it to 0.0.0.0 or your public
# IP to manage it remotely -- if you do, AGENT_SITE_PASSWORD is required,
# or the agent refuses to start (an unauthenticated admin panel with your
# Palworld REST password on a public address is not safe).
AGENT_SITE_HOST=127.0.0.1
# Port the local pairing/server-management site listens on. Defaults to
# 4300 if unset.
AGENT_SITE_PORT=4300
AGENT_SITE_PASSWORD=
